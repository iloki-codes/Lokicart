{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "rootDir": "src",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "skipLibCheck": true,                                /* Skip type checking all .d.ts files. */
    "allowJs": true,
    "strict": true
  }
}